# Shweta AI Desktop Assistant - Environment Configuration
# Copy this file to .env and fill in your values

# Google Gemini API Key (FREE - required)
# Get from: https://aistudio.google.com/apikey
# No credit card needed! Completely free!
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud TTS credentials JSON file path (optional - for cloud TTS)
# If not set, app will use free offline pyttsx3 TTS
# Get from: https://console.cloud.google.com/
GOOGLE_APPLICATION_CREDENTIALS=

# Assistant Settings
ASSISTANT_NAME=Shweta
DEFAULT_LANGUAGE=hi-IN
DEFAULT_CITY=Pune
LOG_LEVEL=INFO

# Spotify API (optional - for deep Spotify control)
# Create app at: https://developer.spotify.com/dashboard
# Set redirect URI: http://localhost:8888/callback
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
