# ============================================================
# SHWETA AI DESKTOP ASSISTANT - Configuration
# ============================================================
# INSTRUCTIONS:
# 1. Rename this file to: .env
# 2. Fill in your API keys below
# 3. Restart Shweta
#
# Minimum required: GEMINI_API_KEY or GROQ_API_KEY (get free at links below)
# ============================================================

# --- AI KEYS (get at least one) ---
# FREE - Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# FREE - Groq Cloud (faster): https://console.groq.com
GROQ_API_KEY=

# FREE - GitHub Models (backup): https://github.com/settings/tokens
GITHUB_TOKEN=

# --- ASSISTANT SETTINGS ---
ASSISTANT_NAME=Shweta
DEFAULT_CITY=Pune
DEFAULT_LANGUAGE=hi-IN
LOG_LEVEL=INFO

# --- BRIEFING SETTINGS ---
BRIEFING_USER_NAME=Your Name
BRIEFING_CITY=Pune

# --- TELEGRAM BOT (optional) ---
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# --- SPOTIFY (optional, needs Premium) ---
# Get at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- EMAIL (optional) ---
# Add email addresses for quick email sending
EMAIL_HR=
EMAIL_MANAGER=
USER_FULL_NAME=Your Name
USER_DESIGNATION=Your Role
